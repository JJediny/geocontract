PREFIX gc: <https://geocontract.dev/ontology/activity-concept-catalog#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT DISTINCT ?code ?label
WHERE {
  ?concept a gc:ActivityConcept ;
    gc:activityCode ?code ;
    skos:prefLabel ?label ;
    skos:altLabel "facade repair" .
}
ORDER BY ?code
