# ── Toolchain & vendored binaries ─────────────────────────────────────────────
# mise-managed and locally-vendored binaries (jxql, dprint wrapper, …)
/.tools/
/.mise/
/.harvest/

# ── Python ────────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# ── Node / pnpm ───────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Rust ──────────────────────────────────────────────────────────────────────
target/
Cargo.lock

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ── Working notes / temp files ────────────────────────────────────────────────
# Stash files used to populate PR bodies via `gh pr create --body-file`
/.pr-body*.md
