{
  "excludes": [
    "**/node_modules",
    "**/.venv",
    "**/target",
    "**/__pycache__",
    "external/**/*.json",
    "catalog/**/collection.json",
    "catalog/**/catalog.json",
    "examples/dcat-us-catalog.example.data.json",
    "examples/datacite4.3/**",
    "portolan-spec",
    "portolan-skills",
    "**/dprint.json",
    ".tools",
    ".harvest",
    ".pytest_cache",
    ".ruff_cache",
    "*.datacontract.yaml",
    "prek.toml",
    "mise.toml"
  ],
  "plugins": [
    "https://plugins.dprint.dev/json-0.23.0.wasm"
  ],
  "json": {
    "indentWidth": 2,
    "lineWidth": 120,
    "useTabs": false,
    "preferSingleLine": true
  }
}
