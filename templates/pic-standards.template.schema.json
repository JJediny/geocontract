        "screening_description": { "type": "string", "x-graphql-field-name": "screeningDescription" },
        "agency": { "type": "string" },
        "DMN_model": { "x-graphql-field-name": "dmnModel", "x-graphql-scalar": "JSON" },
        "parent_model": { "type": "integer", "x-graphql-field-name": "parentModel" },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "x-graphql-field-name": "createdAt",
          "x-graphql-scalar": "DateTime"
        },
        "title": { "type": "string" },
        "notes": { "type": "string" },
        "legal_structure_id": { "type": "integer", "x-graphql-field-name": "legalStructureId" },
        "screening_desc_json": { "x-graphql-field-name": "screeningDescJson", "x-graphql-scalar": "JSON" },
        "other": { "x-graphql-scalar": "JSON" },
        "record_owner_agency": { "type": "string", "x-graphql-field-name": "recordOwnerAgency" }
      },
      "required": ["id"]
    },
    "ProcessDecisionPayload": {
      "type": "object",
      "description": "Data package containing decision-making information.",
      "x-graphql-type-name": "ProcessDecisionPayload",
      "x-graphql-federation-keys": [{ "fields": "id" }],
      "x-graphql-federation-shareable": true,
      "x-graphql-implements": ["Node"],
      "properties": {
        "id": { "type": "integer", "x-graphql-field-type": "ID", "x-graphql-field-non-null": true },
