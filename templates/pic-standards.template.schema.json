        "measure": { "type": "string" },
        "intersect": { "type": "boolean" },
        "spatial_reference": { "type": "string", "x-graphql-field-name": "spatialReference" },
        "form_text": { "type": "string", "x-graphql-field-name": "formText" },
        "form_response_desc": { "type": "string", "x-graphql-field-name": "formResponseDesc" },
        "form_data": { "x-graphql-field-name": "formData", "x-graphql-scalar": "JSON" },
        "evaluation_method": { "type": "string", "x-graphql-field-name": "evaluationMethod" },
        "evaluation_dmn": { "type": "string", "x-graphql-field-name": "evaluationDmn" },
        "threshold": { "x-graphql-scalar": "JSON" },
        "spatial": { "x-graphql-scalar": "JSON" },
        "category": { "type": "string" },
        "data_record_version": { "type": "string", "x-graphql-field-name": "dataRecordVersion" },
        "data_source_agency": { "type": "string", "x-graphql-field-name": "dataSourceAgency" },
        "data_source_system": { "type": "string", "x-graphql-field-name": "dataSourceSystem" }
      },
      "required": ["id"]
    },
    "ProcessModel": {
      "type": "object",
      "description": "Template or framework for a NEPA process.",
      "x-graphql-type-name": "ProcessModel",
      "x-graphql-federation-keys": [{ "fields": "id" }],
      "x-graphql-federation-shareable": true,
