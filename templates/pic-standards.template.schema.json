{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geocontract.dev/schemas/pic-standards.template.schema.json",
  "title": "PIC NEPA Data Standard v1.2 — x-graphql Interoperability Template",
  "description": "Empty template derived from the Permitting Innovation Center NEPA Data Standard (pic-standards v1.2, src/jsonschema/nepa.schema.json). Annotated with x-graphql-* extensions so it round-trips into a federated GraphQL subgraph. Use the json-schema-x-graphql converter (Rust `jxql` or Node `@json-schema-x-graphql/core`) on this file to emit SDL.",
  "type": "object",
  "properties": {
    "projects": {
      "type": "array",
      "description": "Collection of NEPA projects.",
      "items": { "$ref": "#/$defs/Project" }
    },
    "processe_instances": {
      "type": "array",
      "description": "Collection of NEPA processes.",
      "items": { "$ref": "#/$defs/ProcessInstance" }
    },
    "documents": {
      "type": "array",
      "description": "Collection of NEPA documents.",
      "items": { "$ref": "#/$defs/Document" }
    },
    "comments": {
      "type": "array",
      "description": "Collection of public comments.",
      "items": { "$ref": "#/$defs/Comment" }
    },
    "engagements": {
      "type": "array",
      "description": "Collection of public engagement events.",
      "items": { "$ref": "#/$defs/Engagement" }
    },
    "case_events": {
      "type": "array",
      "description": "Collection of case events.",
      "items": { "$ref": "#/$defs/CaseEvent" }
    },
    "gis_data": {
      "type": "array",
      "description": "Collection of GIS data containers.",
      "items": { "$ref": "#/$defs/GisData" }
    },
    "gis_data_elements": {
      "type": "array",
      "description": "Collection of GIS data elements.",
      "items": { "$ref": "#/$defs/GisDataElement" }
    },
    "user_roles": {
      "type": "array",
      "description": "Collection of user roles.",
      "items": { "$ref": "#/$defs/UserRole" }
    },
    "decision_elements": {
      "type": "array",
      "description": "Collection of decision elements.",
      "items": { "$ref": "#/$defs/DecisionElement" }
    },
    "process_models": {
      "type": "array",
      "description": "Collection of process models.",
      "items": { "$ref": "#/$defs/ProcessModel" }
    },
    "process_decision_payloads": {
      "type": "array",
      "description": "Collection of process decision payloads.",
      "items": { "$ref": "#/$defs/ProcessDecisionPayload" }
    },
    "legal_structures": {
      "type": "array",
      "description": "Collection of legal structures.",
      "items": { "$ref": "#/$defs/LegalStructure" }
    }
  },
  "$defs": {
    "Project": {
      "type": "object",
      "description": "An activity or decision requiring a NEPA review process.",
      "x-graphql-type-name": "Project",
      "x-graphql-type-kind": "OBJECT",
      "x-graphql-federation-keys": [{ "fields": "id" }],
      "x-graphql-federation-shareable": true,
      "x-graphql-implements": ["Node"],
      "properties": {
        "id": { "type": "integer", "x-graphql-field-type": "ID", "x-graphql-field-non-null": true },
        "title": { "type": "string", "x-graphql-field-non-null": true },
        "description": { "type": "string", "x-graphql-field-non-null": true },
        "lead_agency": { "type": "string", "x-graphql-field-name": "leadAgency" },
        "participating_agencies": {
          "type": "array",
          "items": { "type": "string" },
          "x-graphql-field-name": "participatingAgencies"
        },
        "location_object": { "$ref": "#/$defs/LocationObject", "x-graphql-field-name": "location" },
        "start_date": {
          "type": "string",
          "format": "date",
          "x-graphql-field-name": "startDate",
          "x-graphql-scalar": "Date"
        },
        "current_status": {
          "type": "string",
          "enum": ["pre-application", "underway", "paused", "completed"],
          "x-graphql-field-name": "currentStatus"
        },
        "location_lat": { "type": "number", "x-graphql-field-name": "locationLat" },
        "location_lon": { "type": "number", "x-graphql-field-name": "locationLon" },
        "sponsor_contact": { "$ref": "#/$defs/SponsorContact", "x-graphql-field-name": "sponsorContact" },
        "data_record_version": { "type": "string", "x-graphql-field-name": "dataRecordVersion" },
        "data_source_agency": { "type": "string", "x-graphql-field-name": "dataSourceAgency" },
        "data_source_system": { "type": "string", "x-graphql-field-name": "dataSourceSystem" },
        "last_updated": {
          "type": "string",
          "format": "date-time",
          "x-graphql-field-name": "lastUpdated",
          "x-graphql-scalar": "DateTime"
        },
        "record_owner_agency": { "type": "string", "x-graphql-field-name": "recordOwnerAgency" },
        "retrieved_timestamp": {
          "type": "string",
          "format": "date-time",
          "x-graphql-field-name": "retrievedTimestamp",
          "x-graphql-scalar": "DateTime"
        }
      },
      "required": ["id", "title", "description"]
    },
    "LocationObject": {
      "type": "object",
      "description": "Geographic area including GIS data.",
      "x-graphql-type-name": "Location",
      "properties": {
        "description": { "type": "string" },
        "gis_reference": { "type": "string", "x-graphql-field-name": "gisReference" }
      },
      "required": ["description"]
    },
    "SponsorContact": {
      "type": "object",
      "description": "Name of responsible entity, organization, or person.",
      "x-graphql-type-name": "SponsorContact",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" }
      }
    },
    "ProcessInstance": {
      "type": "object",
      "description": "Specific type of environmental review, permit, or authorization.",
      "x-graphql-type-name": "ProcessInstance",
      "x-graphql-federation-keys": [{ "fields": "id" }],
      "x-graphql-federation-shareable": true,
      "x-graphql-implements": ["Node"],
      "properties": {
        "id": { "type": "integer", "x-graphql-field-type": "ID", "x-graphql-field-non-null": true },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "x-graphql-field-name": "createdAt",
          "x-graphql-scalar": "DateTime"
        },
        "parent_process_id": { "type": "integer", "x-graphql-field-name": "parentProcessId" },
        "parent_project_id": { "type": "integer", "x-graphql-field-name": "parentProjectId" },
        "agency_id": { "type": "string", "x-graphql-field-name": "agencyId" },
        "federal_id": { "type": "string", "x-graphql-field-name": "federalId" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "stage": { "type": "string" },
        "start_date": {
          "type": "string",
          "format": "date",
          "x-graphql-field-name": "startDate",
          "x-graphql-scalar": "Date"
        },
        "complete_date": {
          "type": "string",
          "format": "date",
          "x-graphql-field-name": "completeDate",
          "x-graphql-scalar": "Date"
        },
        "outcome": { "type": "string" },
        "lead_agency": { "type": "string", "x-graphql-field-name": "leadAgency" },
        "joint_lead_agency": { "type": "string", "x-graphql-field-name": "jointLeadAgency" },
        "cooperating_agencies": {
          "type": "array",
          "items": { "type": "string" },
          "x-graphql-field-name": "cooperatingAgencies"
        }
      },
      "required": ["id"]
    },
    "Document": {
      "type": "object",
      "description": "Official record created during the NEPA review.",
      "x-graphql-type-name": "Document",
      "x-graphql-federation-keys": [{ "fields": "id" }],
      "x-graphql-federation-shareable": true,
      "x-graphql-implements": ["Node"],
      "properties": {
        "id": { "type": "integer", "x-graphql-field-type": "ID", "x-graphql-field-non-null": true },
        "document_type": { "type": "string", "x-graphql-field-name": "documentType" },
        "title": { "type": "string" },
        "volume_title": { "type": "string", "x-graphql-field-name": "volumeTitle" },
        "publish_date": {
          "type": "string",
          "format": "date",
          "x-graphql-field-name": "publishDate",
          "x-graphql-scalar": "Date"
        },
        "prepared_by": { "type": "string", "x-graphql-field-name": "preparedBy" },
        "status": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "notes": { "type": "string" },
        "related_document_id": { "type": "integer", "x-graphql-field-name": "relatedDocumentId" },
        "document_summary": { "x-graphql-field-name": "documentSummary", "x-graphql-scalar": "JSON" },
        "document_toc": { "x-graphql-field-name": "documentToc", "x-graphql-scalar": "JSON" },
        "public_access": { "type": "boolean", "x-graphql-field-name": "publicAccess" },
        "data_record_version": { "type": "string", "x-graphql-field-name": "dataRecordVersion" },
        "data_source_agency": { "type": "string", "x-graphql-field-name": "dataSourceAgency" }
      },
      "required": ["id"]
    },
    "Comment": {
      "type": "object",
      "description": "Feedback submitted during the NEPA process.",
      "x-graphql-type-name": "Comment",
      "x-graphql-federation-keys": [{ "fields": "id" }],
      "x-graphql-federation-shareable": true,
      "x-graphql-implements": ["Node"],
      "properties": {
        "id": { "type": "integer", "x-graphql-field-type": "ID", "x-graphql-field-non-null": true },
        "commenter_entity": { "type": "string", "x-graphql-field-name": "commenterEntity" },
        "content_text": { "type": "string", "x-graphql-field-name": "contentText" },
        "date_submitted": {
          "type": "string",
          "format": "date",
          "x-graphql-field-name": "dateSubmitted",
          "x-graphql-scalar": "Date"
        },
        "parent_document_id": { "type": "integer", "x-graphql-field-name": "parentDocumentId" },
        "submission_method": { "type": "string", "x-graphql-field-name": "submissionMethod" },
        "response_text": { "type": "string", "x-graphql-field-name": "responseText" },
        "public_source": { "type": "boolean", "x-graphql-field-name": "publicSource" },
        "content_json": { "x-graphql-field-name": "contentJson", "x-graphql-scalar": "JSON" },
        "response_json": { "x-graphql-field-name": "responseJson", "x-graphql-scalar": "JSON" },
        "public_access": { "type": "boolean", "x-graphql-field-name": "publicAccess" },
        "other": { "x-graphql-scalar": "JSON" },
        "record_owner_agency": { "type": "string", "x-graphql-field-name": "recordOwnerAgency" },
        "data_source_agency": { "type": "string", "x-graphql-field-name": "dataSourceAgency" },
        "data_source_system": { "type": "string", "x-graphql-field-name": "dataSourceSystem" }
      },
      "required": ["id"]
    },
    "Engagement": {
      "type": "object",
      "description": "Opportunities for interaction in the NEPA process.",
      "x-graphql-type-name": "Engagement",
      "x-graphql-federation-keys": [{ "fields": "id" }],
      "x-graphql-federation-shareable": true,
      "x-graphql-implements": ["Node"],
      "properties": {
        "id": { "type": "integer", "x-graphql-field-type": "ID", "x-graphql-field-non-null": true },
        "type": { "type": "string" },
        "start_datetime": {
          "type": "string",
          "format": "date-time",
          "x-graphql-field-name": "startDatetime",
          "x-graphql-scalar": "DateTime"
        },
        "end_datetime": {
          "type": "string",
          "format": "date-time",
          "x-graphql-field-name": "endDatetime",
          "x-graphql-scalar": "DateTime"
        },
        "location": { "type": "string" },
        "parent_process_id": { "type": "integer", "x-graphql-field-name": "parentProcessId" },
        "attendance": { "type": "integer" },
        "related_document_id": { "type": "integer", "x-graphql-field-name": "relatedDocumentId" },
        "participation": { "type": "integer" },
        "other": { "x-graphql-scalar": "JSON" },
        "notes": { "type": "string" },
        "record_owner_agency": { "type": "string", "x-graphql-field-name": "recordOwnerAgency" },
        "data_source_agency": { "type": "string", "x-graphql-field-name": "dataSourceAgency" },
        "data_source_system": { "type": "string", "x-graphql-field-name": "dataSourceSystem" },
        "data_record_version": { "type": "string", "x-graphql-field-name": "dataRecordVersion" }
      },
      "required": ["id"]
    },
    "CaseEvent": {
      "type": "object",
      "description": "Milestones or steps within the NEPA review.",
      "x-graphql-type-name": "CaseEvent",
      "x-graphql-federation-keys": [{ "fields": "id" }],
      "x-graphql-federation-shareable": true,
      "x-graphql-implements": ["Node"],
      "properties": {
        "id": { "type": "integer", "x-graphql-field-type": "ID", "x-graphql-field-non-null": true },
        "source": { "type": "string" },
        "type": { "type": "string" },
        "tier": { "type": "integer" },
        "status": { "type": "string" },
        "outcome": { "type": "string" },
        "related_document_id": { "type": "integer", "x-graphql-field-name": "relatedDocumentId" },
        "public_access": { "type": "boolean", "x-graphql-field-name": "publicAccess" },
        "description": { "type": "string" },
        "assigned_entity": { "type": "string", "x-graphql-field-name": "assignedEntity" },
        "following_segment_name": { "type": "string", "x-graphql-field-name": "followingSegmentName" },
        "parent_event_id": { "type": "integer", "x-graphql-field-name": "parentEventId" },
        "related_engagement_id": { "type": "integer", "x-graphql-field-name": "relatedEngagementId" },
        "data_record_version": { "type": "string", "x-graphql-field-name": "dataRecordVersion" },
        "data_source_agency": { "type": "string", "x-graphql-field-name": "dataSourceAgency" }
      },
      "required": ["id"]
    },
    "GisData": {
      "type": "object",
      "description": "Geospatial data and metadata associated with NEPA projects.",
      "x-graphql-type-name": "GisData",
      "x-graphql-federation-keys": [{ "fields": "id" }],
      "x-graphql-federation-shareable": true,
      "x-graphql-implements": ["Node"],
      "properties": {
        "id": { "type": "integer", "x-graphql-field-type": "ID", "x-graphql-field-non-null": true },
        "creator": { "type": "string" },
        "description": { "type": "string" },
        "extent": { "x-graphql-scalar": "JSON" },
        "notes": { "type": "string" },
        "container_inventory": { "x-graphql-field-name": "containerInventory", "x-graphql-scalar": "JSON" },
        "parent_project_id": { "type": "integer", "x-graphql-field-name": "parentProjectId" },
        "parent_process_id": { "type": "integer", "x-graphql-field-name": "parentProcessId" },
        "parent_document_id": { "type": "integer", "x-graphql-field-name": "parentDocumentId" },
        "parent_case_event_id": { "type": "integer", "x-graphql-field-name": "parentCaseEventId" },
        "parent_comment_id": { "type": "integer", "x-graphql-field-name": "parentCommentId" },
        "parent_engagement_id": { "type": "integer", "x-graphql-field-name": "parentEngagementId" },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "x-graphql-field-name": "createdAt",
          "x-graphql-scalar": "DateTime"
        },
        "centroid_lat": { "type": "number", "x-graphql-field-name": "centroidLat" },
        "centroid_lon": { "type": "number", "x-graphql-field-name": "centroidLon" }
      },
      "required": ["id"]
    },
    "GisDataElement": {
      "type": "object",
      "description": "Individual elements within GIS data containers.",
      "x-graphql-type-name": "GisDataElement",
      "x-graphql-federation-keys": [{ "fields": "id" }],
      "x-graphql-federation-shareable": true,
      "x-graphql-implements": ["Node"],
      "properties": {
        "id": { "type": "integer", "x-graphql-field-type": "ID", "x-graphql-field-non-null": true },
