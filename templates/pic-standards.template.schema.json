        "bot_right_lon": { "type": "number", "x-graphql-field-name": "botRightLon" },
        "purpose": { "type": "string" },
        "data_match": { "type": "boolean", "x-graphql-field-name": "dataMatch" },
        "access_info": { "type": "string", "x-graphql-field-name": "accessInfo" },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "x-graphql-field-name": "createdAt",
          "x-graphql-scalar": "DateTime"
        },
        "parent_gis": { "type": "integer", "x-graphql-field-name": "parentGis" },
        "format": { "type": "string" },
        "other": { "x-graphql-scalar": "JSON" }
      },
      "required": ["id"]
    },
    "UserRole": {
      "type": "object",
      "description": "Defines a stakeholder interacting with the NEPA IT system.",
      "x-graphql-type-name": "UserRole",
      "x-graphql-federation-keys": [{ "fields": "id" }],
      "x-graphql-federation-shareable": true,
      "x-graphql-implements": ["Node"],
      "properties": {
        "id": { "type": "integer", "x-graphql-field-type": "ID", "x-graphql-field-non-null": true },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "public": { "type": "boolean" },
        "access_policy": { "type": "string", "x-graphql-field-name": "accessPolicy" },
        "permission_descriptions": {
          "type": "array",
          "items": { "type": "string" },
          "x-graphql-field-name": "permissionDescriptions"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "x-graphql-field-name": "createdAt",
          "x-graphql-scalar": "DateTime"
        },
        "other": { "x-graphql-scalar": "JSON" },
        "record_owner_agency": { "type": "string", "x-graphql-field-name": "recordOwnerAgency" },
        "data_source_agency": { "type": "string", "x-graphql-field-name": "dataSourceAgency" },
        "data_source_system": { "type": "string", "x-graphql-field-name": "dataSourceSystem" },
        "data_record_version": { "type": "string", "x-graphql-field-name": "dataRecordVersion" },
        "last_updated": {
          "type": "string",
          "format": "date-time",
          "x-graphql-field-name": "lastUpdated",
          "x-graphql-scalar": "DateTime"
        },
        "retrieved_timestamp": {
          "type": "string",
          "format": "date-time",
          "x-graphql-field-name": "retrievedTimestamp",
          "x-graphql-scalar": "DateTime"
        }
      },
      "required": ["id"]
    },
    "DecisionElement": {
      "type": "object",
